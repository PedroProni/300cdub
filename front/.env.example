# Base URL of the API used by the SPA (cookie session, so the API must allow this origin with credentials)
VITE_API_URL=http://localhost:3000/api
# Public origin of the API, used for share links (/p/:slug serves Open Graph tags for crawlers)
VITE_API_PUBLIC_ORIGIN=http://localhost:3000

# Optional link to the image credits page shown in the footer (hidden when empty)
VITE_CREDITS_URL=
