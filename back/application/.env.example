# HTTP port inside the container or on the host
PORT=3000

# MongoDB connection string including the database name
MONGODB_URI=mongodb://localhost:27017/cdub

# Secret used to sign the admin session cookie (32+ random characters)
JWT_SECRET=

# First admin, created only when no admin exists yet
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma separated browser origins allowed to call the API with credentials
ALLOWED_ORIGINS=http://localhost:5173

# Public URL of the web app (used by the share page redirect)
PUBLIC_SITE_URL=http://localhost:5173

# Set true behind HTTPS so the session cookie is Secure
COOKIE_SECURE=false

# Set true when running behind a reverse proxy so the login limit sees the real client IP
TRUST_PROXY=false

# Expose Swagger at /docs
SWAGGER_ENABLED=true

# Object storage (S3 compatible: MinIO locally, Cloudflare R2 in production)
# MinIO: S3_ENDPOINT=http://localhost:9000  S3_FORCE_PATH_STYLE=true  S3_PUBLIC_BASE_URL=http://localhost:9000/<bucket>
# R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto  S3_FORCE_PATH_STYLE=false  S3_PUBLIC_BASE_URL=https://<your r2.dev or custom domain>
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=cdub-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
